package tests;

use ecosystem::rope::examples::basic as application;
use ecosystem::rope;
use std::io;
use std::bytes;
use std::testing;

#[test]
fn exported_document_and_generic_stream_api() -> () {
    application::exercise();
    let input = io::Cursor::new(bytes::Bytes::from_string("跨模块😀\r\n"));
    let document = testing::expect_ok(
        rope::Rope::from_reader(input, 100),
        "imported generic reader",
    );
    let output = io::Cursor::new(bytes::Bytes::new());
    testing::expect_ok(document.write_to(output), "imported generic writer");
    testing::assert(output.bytes().to_vec() == "跨模块😀\r\n".to_bytes());
    let saved = document;
    let edited = testing::expect_ok(document.remove(0, 1), "imported edit");
    testing::assert_eq(saved.to_string(), "跨模块😀\r\n");
    testing::assert_eq(edited.to_string(), "模块😀\r\n");
}

#[test]
fn downstream_backward_word_scan_preserves_unicode() -> () {
    let document = testing::expect_ok(rope::Rope::from_string("first 😀é"), "rope");
    let cursor = testing::expect_ok(document.scalars_before(document.len_scalars()), "cursor");
    let word: Vec[char] = Vec::new();
    while let Some(ch) = cursor.next() {
        if ch == ' ' {
            break;
        }
        word.push(ch);
    }
    testing::assert(word == Vec::from_array(['é', '😀']));
}

#[test]
fn downstream_reverse_chunks_and_byte_prefixes() -> () {
    let document = testing::expect_ok(rope::Rope::from_string("é😀"), "rope");
    let chunks: Vec[string] = Vec::new();
    for chunk in testing::expect_ok(document.chunks_before_byte(2), "chunks") {
        chunks.push(chunk);
    }
    testing::assert_eq(chunks.join(""), "é");
    testing::assert_eq(
        testing::expect_some(
            testing::expect_ok(document.bytes_before(1), "interior prefix").next(),
            "byte",
        ),
        195,
    );
}

#[test]
fn downstream_reverse_lines_support_editor_navigation() -> () {
    let document = testing::expect_ok(rope::Rope::from_string("first\r\n😀\nlast"), "rope");
    let cursor = testing::expect_ok(document.line_contents_before(2), "previous lines");
    testing::assert_eq(testing::expect_some(cursor.next(), "previous").to_string(), "😀");
    testing::assert_eq(testing::expect_some(cursor.next(), "first").to_string(), "first");
    testing::assert_none(cursor.next());
    testing::assert_eq(
        testing::expect_some(document.lines_rev().next(), "last").to_string(),
        "last",
    );
}
